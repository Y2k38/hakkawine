<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold">New Ticket</h1>
      <p class="text-sm text-base-content/60 mt-1">Please describe the issue clearly and any operations you have tried</p>
    </div>
    <.link patch={~p"/tickets"} class="btn btn-sm btn-ghost bg-base-200/60 font-normal">Back to List</.link>
  </div>

  <div class="card bg-base-100 shadow-sm border border-base-300">
    <div class="card-body space-y-5">
      <div class="space-y-2">
        <label class="text-xs font-semibold text-base-content/80">Subject <span class="text-error">*</span></label>
        <input type="text" placeholder="" class="input input-bordered input-sm w-full bg-base-200/40 text-sm" />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="space-y-2">
          <label class="text-xs font-semibold text-base-content/80">Category</label>
          <select class="select select-bordered select-sm w-full bg-base-200/40 text-sm">
            <option disabled selected>Unselected</option>
            <option>Technical Support</option>
            <option>Pre-sale Support</option>
            <option>Others</option>
          </select>
        </div>

        <div class="space-y-2">
          <label class="text-xs font-semibold text-base-content/80">Priority <span class="text-error">*</span></label>
          <div class="flex gap-2">
            <button type="button" class="btn btn-sm btn-ghost bg-base-200/60 font-normal flex-1">Low</button>
            <button type="button" class="btn btn-sm btn-neutral font-medium flex-1">Normal</button>
            <button type="button" class="btn btn-sm btn-ghost bg-base-200/60 font-normal flex-1">High</button>
            <button type="button" class="btn btn-sm btn-ghost bg-base-200/60 font-normal flex-1">Urgent</button>
          </div>
        </div>
      </div>

      <div class="space-y-2">
        <label class="text-xs font-semibold text-base-content/80">Related Service <span class="text-xs text-base-content/50 font-normal">Optional</span></label>
        <select class="select select-bordered select-sm w-full bg-base-200/40 text-sm">
          <option selected>Unlinked</option>
          <option>#373398 · Gold (Expired · Expiration: 2026/10/7)</option>
          <option>#224397 · Bronze (Active · Expiration: 2026/11/17)</option>
        </select>
      </div>

      <div class="space-y-2">
        <label class="text-xs font-semibold text-base-content/80">Content <span class="text-error">*</span></label>
        <textarea class="textarea textarea-bordered w-full bg-base-200/40 h-36 text-sm" placeholder="Describe the issue, you can paste screenshots"></textarea>
        
        <div class="flex items-center justify-between pt-2">
          <button type="button" class="btn btn-sm btn-ghost bg-base-200/60 font-normal gap-2">
            <span>📷</span> Upload Image
          </button>
          <button type="button" class="btn btn-warning text-warning-content btn-sm px-6">Submit Ticket</button>
        </div>
      </div>

      <div class="text-[11px] text-base-content/50 pt-2 border-t border-base-300/40">
        Max 5 images, single ≤10MB; supports PNG / JPG / GIF / WEBP
      </div>
    </div>
  </div>
</div>