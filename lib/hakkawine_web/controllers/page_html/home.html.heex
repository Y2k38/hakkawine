<Layouts.flash_group flash={@flash} />

<div class="space-y-6">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    
    <div class="lg:col-span-2 space-y-6">
      
      <div class="card bg-base-100 shadow-sm border border-base-300">
        <div class="card-body">
          <div class="flex items-center justify-between mb-2">
            <h2 class="card-title text-base font-bold">My Services</h2>
            <div class="flex gap-2">
              <button class="btn btn-sm btn-ghost bg-base-200/60 font-normal">All Services</button>
              <button class="btn btn-sm btn-ghost bg-base-200/60 font-normal">Go to Shop</button>
            </div>
          </div>

          <div class="bg-base-200/40 rounded-2xl p-5 border border-base-300/60 space-y-4">
            <div class="flex items-center justify-between">
              <span class="font-bold text-lg">Bronze</span>
              <span class="badge badge-success text-success-content font-medium text-xs px-2.5 py-1">Active</span>
            </div>

            <div class="grid grid-cols-3 gap-4 text-sm">
              <div>
                <div class="text-base-content/60 text-xs mb-1">Plan Traffic</div>
                <div class="font-semibold text-base">150.00 GiB</div>
              </div>
              <div>
                <div class="text-base-content/60 text-xs mb-1">Used Traffic</div>
                <div class="font-semibold text-base">19.35 GiB</div>
              </div>
              <div>
                <div class="text-base-content/60 text-xs mb-1">Remaining Traffic</div>
                <div class="font-semibold text-base">130.65 GiB</div>
              </div>
            </div>

            <div class="space-y-1">
              <div class="flex justify-between text-xs text-base-content/70">
                <span>Used 13%</span>
                <span>87% Remaining</span>
              </div>
              <progress class="progress progress-success w-full h-2" value="13" max="100"></progress>
            </div>

            <div class="flex flex-wrap justify-between text-xs text-base-content/60 pt-2 border-t border-base-300/40">
              <span>Expiration: 2026/11/17</span>
              <span>Next Reset: 2026/10/17</span>
            </div>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 shadow-sm border border-base-300">
        <div class="card-body">
          <h2 class="card-title text-base font-bold mb-1">Quick Actions</h2>
          <p class="text-xs text-base-content/60 mb-3">Quick access to frequent features</p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            
            <a href={~p"/knowledge"} class="flex items-center justify-between p-3 rounded-xl bg-base-200/40 hover:bg-base-200/80 transition border border-base-300/40">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-warning/10 text-warning flex items-center justify-center font-bold">
                  📚
                </div>
                <div>
                  <div class="font-semibold text-sm">Knowledgebase</div>
                  <div class="text-xs text-base-content/60">Tutorials & FAQs</div>
                </div>
              </div>
              <span class="text-base-content/40">→</span>
            </a>

            <a href={~p"/plan/list"} class="flex items-center justify-between p-3 rounded-xl bg-base-200/40 hover:bg-base-200/80 transition border border-base-300/40">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-warning/10 text-warning flex items-center justify-center font-bold">
                  🛒
                </div>
                <div>
                  <div class="font-semibold text-sm">Buy Plan</div>
                  <div class="text-xs text-base-content/60">Choose a suitable plan</div>
                </div>
              </div>
              <span class="text-base-content/40">→</span>
            </a>

            <a href={~p"/home"} class="flex items-center justify-between p-3 rounded-xl bg-base-200/40 hover:bg-base-200/80 transition border border-base-300/40">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-warning/10 text-warning flex items-center justify-center font-bold">
                  💳
                </div>
                <div>
                  <div class="font-semibold text-sm">Top-up</div>
                  <div class="text-xs text-base-content/60">Balance & records</div>
                </div>
              </div>
              <span class="text-base-content/40">→</span>
            </a>

            <a href={~p"/tickets"} class="flex items-center justify-between p-3 rounded-xl bg-base-200/40 hover:bg-base-200/80 transition border border-base-300/40">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-warning/10 text-warning flex items-center justify-center font-bold">
                  🎫
                </div>
                <div>
                  <div class="font-semibold text-sm">Submit Ticket</div>
                  <div class="text-xs text-base-content/60">Get technical support</div>
                </div>
              </div>
              <span class="text-base-content/40">→</span>
            </a>

          </div>
        </div>
      </div>

    </div>

    <div class="space-y-6">
      
      <div class="card bg-base-100 shadow-sm border border-base-300">
        <div class="card-body">
          <h2 class="card-title text-base font-bold mb-3">Account Overview</h2>

          <div class="grid grid-cols-2 gap-y-4 gap-x-2 text-sm">
            <div>
              <div class="text-base-content/60 text-xs mb-1">Balance</div>
              <div class="text-lg font-bold text-warning">¥22.61</div>
              <a href="#" class="text-xs text-warning hover:underline">Top-up</a>
            </div>

            <div>
              <div class="text-base-content/60 text-xs mb-1">Active Services</div>
              <div class="text-lg font-bold">1</div>
              <a href="#" class="text-xs text-base-content/60 hover:underline">Manage</a>
            </div>

            <div class="divider col-span-2 my-0"></div>

            <div>
              <div class="text-base-content/60 text-xs mb-1">Total Traffic</div>
              <div class="font-bold text-base">130.65 GiB</div>
              <div class="text-xs text-base-content/50">Sum of active services</div>
            </div>

            <div>
              <div class="text-base-content/60 text-xs mb-1">AFF Commission</div>
              <div class="font-bold text-base">¥0.00</div>
              <a href={~p"/affiliate"} class="text-xs text-warning hover:underline">Affiliate Center →</a>
            </div>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 shadow-sm border border-base-300">
        <div class="card-body">
          <h2 class="card-title text-base font-bold mb-1">Daily Bonus</h2>
          <p class="text-xs text-base-content/60 mb-4">Check-in for extra traffic</p>

          <div class="flex items-center justify-between bg-base-200/40 p-4 rounded-xl border border-base-300/40 mb-3">
            <div>
              <div class="text-sm font-semibold">Lucky Draw</div>
              <div class="text-xs text-base-content/60 mt-0.5">Today 90 · 1–1024 MiB</div>
            </div>
            <button class="btn btn-warning text-warning-content btn-sm px-6">Check-in</button>
          </div>

          <p class="text-xs text-base-content/60 leading-relaxed">
            Check-in to randomly win traffic rewards, valid only for the current billing cycle.
          </p>

          <div class="mt-2 pt-3 border-t border-base-300/40 text-xs">
            <span class="text-base-content/60">Having trouble?</span>
            <a href={~p"/knowledge"} class="text-warning font-medium hover:underline ml-1">Help Center →</a>
          </div>
        </div>
      </div>

    </div>

  </div>
</div>