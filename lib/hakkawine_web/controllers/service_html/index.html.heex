<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold">My Services</h1>
      <p class="text-sm text-base-content/60 mt-1">View and manage your purchased services</p>
    </div>
    <a href={~p"/plan/list"} class="btn btn-warning text-warning-content btn-sm px-5">Buy Plan</a>
  </div>

  <div class="card bg-base-100 shadow-sm border border-base-300">
    <div class="card-body p-0">
      <div class="overflow-x-auto">
        <table class="table w-full text-sm">
          <thead>
            <tr class="text-xs text-base-content/60 border-b border-base-300/60">
              <th class="py-4 px-6">Plan / Service ID</th>
              <th class="py-4 px-6">Status</th>
              <th class="py-4 px-6">Traffic Usage</th>
              <th class="py-4 px-6">Billing / Reset</th>
              <th class="py-4 px-6">Expiration</th>
              <th class="py-4 px-6 text-right">Action</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-base-300/40 hover:bg-base-200/30">
              <td class="py-4 px-6">
                <div class="font-bold text-sm">Bronze</div>
                <div class="text-xs text-base-content/50 font-mono">Service ID #224397</div>
              </td>
              <td class="py-4 px-6">
                <span class="text-success font-medium">Active</span>
              </td>
              <td class="py-4 px-6">
                <div class="text-xs font-medium mb-1">19.35 GiB / 150.00 GiB</div>
                <progress class="progress progress-success w-32 h-1.5" value="13" max="100"></progress>
              </td>
              <td class="py-4 px-6 text-xs text-base-content/70 font-mono">2026/10/17 00:00:00</td>
              <td class="py-4 px-6 text-xs text-base-content/70 font-mono">2026/11/17 00:00:00</td>
              <td class="py-4 px-6 text-right">
                <a href="#" class="text-xs text-warning hover:underline font-medium">Details</a>
              </td>
            </tr>

            <tr class="border-b border-base-300/40 hover:bg-base-200/30">
              <td class="py-4 px-6">
                <div class="font-bold text-sm">Gold</div>
                <div class="text-xs text-base-content/50 font-mono">Service ID #373398</div>
              </td>
              <td class="py-4 px-6">
                <span class="text-error font-medium">Expired</span>
              </td>
              <td class="py-4 px-6 text-xs text-base-content/50">
                —
              </td>
              <td class="py-4 px-6 text-xs text-base-content/70 font-mono">2026/10/7 00:00:00</td>
              <td class="py-4 px-6 text-xs text-base-content/70 font-mono">2026/10/7 00:00:00</td>
              <td class="py-4 px-6 text-right">
                <a href="#" class="text-xs text-warning hover:underline font-medium">Details</a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>