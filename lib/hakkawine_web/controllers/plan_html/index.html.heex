<Layouts.flash_group flash={@flash} />
<div class="max-w-7xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <!-- Header -->
  <div class="text-center mb-12">
    <h1 class="text-4xl font-extrabold tracking-tight">Choose Your Plan</h1>
    <p class="mt-3 text-lg text-base-content/70">Select the best high-speed network plan that fits your needs.</p>
  </div>

  <section class="mb-16">
    <div class="border-b border-base-300 pb-4 mb-8">
      <h2 class="text-2xl font-bold">Subscription Plans</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch">
      <%= for plan <- @recurring_plans do %>
        <% 
          default_price = get_default_price(plan.prices) 
          reset_price = get_reset_price(plan.prices)
        %>
        <div class={[
          "card bg-base-100 transition-all duration-300 relative",
          if(plan.is_recommended, 
            do: "border-2 border-primary ring-2 ring-primary/30 shadow-2xl scale-105 z-10", 
            else: "border border-base-200 shadow-xl hover:shadow-2xl"
          )
        ]}>
          <!-- Recommended Badge -->
          <%= if plan.is_recommended do %>
            <div class="badge badge-primary font-bold text-xs uppercase tracking-wider absolute -top-3.5 right-6 shadow-md py-3 px-4">
              Recommended
            </div>
          <% end %>

          <div class="card-body p-6 flex flex-col justify-between">
            <div>
              <!-- Title -->
              <h3 class="card-title text-xl font-bold mb-2"><%= plan.name %></h3>

              <!-- Price -->
              <div class="my-4">
                <%= if default_price do %>
                  <span class="text-3xl font-extrabold"><%= currency_symbol() %><%= format_amount(default_price.amount) %></span>
                  <span class="text-sm font-medium text-base-content/60">/ month starting</span>
                <% else %>
                  <span class="text-xl font-medium text-base-content/40">Unavailable</span>
                <% end %>
              </div>

              <div class="divider my-2"></div>

              <!-- Features List -->
              <ul class="space-y-3 text-sm">
                <li class="flex justify-between items-center">
                  <span class="text-base-content/70">Traffic Quota</span>
                  <span class="font-semibold"><%= format_traffic(plan.traffic_quota_bytes) %>/month</span>
                </li>
                <li class="flex justify-between items-center">
                  <span class="text-base-content/70">Port Speed</span>
                  <span class="font-semibold"><%= format_speed(plan.limit_speed_mbps) %></span>
                </li>
                <li class="flex justify-between items-center">
                  <span class="text-base-content/70">Reset Policy</span>
                  <span class="font-semibold">Auto-reset every cycle</span>
                </li>
                <li class="flex justify-between items-center">
                  <span class="text-base-content/70">Manual Reset Price</span>
                  <span class="font-semibold">
                    <%= if reset_price, do: "#{currency_symbol()}#{format_amount(reset_price.amount)} / time", else: "Not Supported" %>
                  </span>
                </li>
                <li class="flex justify-between items-center">
                  <span class="text-base-content/70">Check-in Bonus</span>
                  <span class="font-semibold text-success">Available</span>
                </li>
                <li class="flex justify-between items-center">
                  <span class="text-base-content/70">Max Devices</span>
                  <span class="font-semibold">Up to <%= plan.limit_device_count %> devices</span>
                </li>
              </ul>
            </div>

            <!-- Action Button -->
            <div class="card-actions justify-end mt-8 pt-4 border-t border-base-200">
              <%= if plan.status == :active do %>
                <a href={"/checkout/sub/new?code=#{plan.code}"} class="btn btn-primary btn-block rounded-xl">
                  Subscribe Now
                </a>
              <% else %>
                <div class="w-full text-center">
                  <button disabled class="btn btn-disabled btn-block rounded-xl mb-2">
                    Currently Unavailable
                  </button>
                  <p class="text-xs text-base-content/60">Please go to plan details to renew or upgrade.</p>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <section>
    <div class="border-b border-base-300 pb-4 mb-2">
      <h2 class="text-2xl font-bold">One-Time Plans</h2>
      <p class="text-sm text-base-content/60 mt-1">Can be held alongside subscription plans. Valid for 1 year from payment with no automatic reset.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-8">
      <%= for plan <- @one_time_plans do %>
        <% price = get_default_price(plan.prices) %>
        <div class="card bg-base-100 shadow-xl border border-base-200 transition-all duration-200 hover:shadow-2xl">
          <div class="card-body p-6 flex flex-col justify-between">
            <div>
              <!-- Title -->
              <h3 class="card-title text-xl font-bold mb-2"><%= plan.name %></h3>

              <!-- Price -->
              <div class="my-4">
                <%= if price do %>
                  <span class="text-3xl font-extrabold"><%= currency_symbol() %><%= format_amount(price.amount) %></span>
                  <span class="text-sm font-medium text-base-content/60">/ year</span>
                <% else %>
                  <span class="text-xl font-medium text-base-content/40">Unavailable</span>
                <% end %>
              </div>

              <div class="divider my-2"></div>

              <!-- Features List -->
              <ul class="space-y-3 text-sm">
                <li class="flex justify-between items-center">
                  <span class="text-base-content/70">Traffic Quota</span>
                  <span class="font-semibold"><%= format_traffic(plan.traffic_quota_bytes) %></span>
                </li>
                <li class="flex justify-between items-center">
                  <span class="text-base-content/70">Port Speed</span>
                  <span class="font-semibold"><%= format_speed(plan.limit_speed_mbps) %></span>
                </li>
                <li class="flex justify-between items-center">
                  <span class="text-base-content/70">Validity Period</span>
                  <span class="font-semibold">1 Year</span>
                </li>
                <li class="flex justify-between items-center">
                  <span class="text-base-content/70">Reset Policy</span>
                  <span class="font-semibold">No reset during validity</span>
                </li>
                <li class="flex justify-between items-center">
                  <span class="text-base-content/70">Manual Reset Price</span>
                  <span class="font-semibold">Not Supported</span>
                </li>
                <li class="flex justify-between items-center">
                  <span class="text-base-content/70">Check-in Bonus</span>
                  <span class="font-semibold text-base-content/40">Excluded</span>
                </li>
                <li class="flex justify-between items-center">
                  <span class="text-base-content/70">Max Devices</span>
                  <span class="font-semibold">Up to <%= plan.limit_device_count %> devices</span>
                </li>
              </ul>
            </div>

            <!-- Action Button -->
            <div class="card-actions justify-end mt-8 pt-4 border-t border-base-200">
              <%= if plan.status == :active do %>
                <a href={"/checkout/sub/new?code=#{plan.code}"} class="btn btn-neutral btn-block rounded-xl">
                  Purchase Now
                </a>
              <% else %>
                <button disabled class="btn btn-disabled btn-block rounded-xl">
                  Currently Unavailable
                </button>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </section>
</div>