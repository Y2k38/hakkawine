<Layouts.flash_group flash={@flash} />

<div class="max-w-md mx-auto my-12">
  <div class="p-8 bg-base-100 rounded-xl shadow-xl border border-base-200">
    
    <div class="mb-6 text-center">
      <h2 class="text-2xl font-bold text-base-content">Reset Password</h2>
      <p class="text-xs text-base-content/60 mt-1.5 leading-relaxed">
        Enter your registered email address and we'll send you a link to reset your password.
      </p>
    </div>

    <.form :let={f} for={@changeset} action={~p"/auth/send_reset_link"} class="space-y-4">
      
      <div class="form-control w-full">
        <label class="label" for="reset-email">
          <span class="label-text font-medium">Email Address</span>
        </label>
        <input 
          id="reset-email"
          type="email" 
          name={f[:email].name}
          value={f[:email].value}
          required 
          placeholder="name@company.com" 
          class={["input input-bordered w-full focus:outline-primary", f[:email].errors != [] && "input-error"]} 
        />
        <div :for={{msg, _opts} <- f[:email].errors} class="label py-1">
          <span class="label-text-alt text-error font-medium"><%= msg %></span>
        </div>
      </div>

      <div class="pt-2">
        <button type="submit" class="btn btn-primary w-full text-base font-medium shadow-sm">
          Send Reset Link
        </button>
      </div>

    </.form>

    <div class="mt-6 pt-4 border-t border-base-200 text-center text-xs text-base-content/70">
      Remember your password? 
      <.link navigate={~p"/auth/log_in"} class="text-primary font-semibold hover:underline ml-1">
        Sign in
      </.link>
    </div>

  </div>
</div>