<Layouts.flash_group flash={@flash} />

<div class="max-w-md mx-auto my-12">
  <div class="p-8 bg-base-100 rounded-xl shadow-xl border border-base-200">
    
    <div class="mb-6 text-center">
      <h2 class="text-2xl font-bold text-base-content">Set New Password</h2>
      <p class="text-xs text-base-content/60 mt-1.5 leading-relaxed">
        Please enter your new password below.
      </p>
    </div>

    <.form :let={f} for={@changeset} action={~p"/auth/reset_password?token=#{@token}"} class="space-y-4">
      
      <input type="hidden" name={f[:token].name} value={@token} />

      <%!-- New Password --%>
      <div class="form-control w-full">
        <label class="label" for="reset-new-password">
          <span class="label-text font-medium">New Password</span>
        </label>
        <input 
          id="reset-new-password"
          type="password" 
          name={f[:password].name}
          value={f[:password].value}
          required 
          placeholder="••••••••" 
          class={["input input-bordered w-full focus:outline-primary", f[:password].errors != [] && "input-error"]} 
        />
        <div :for={{msg, _opts} <- f[:password].errors} class="label py-1">
          <span class="label-text-alt text-error font-medium"><%= msg %></span>
        </div>
      </div>

      <div :if={Map.has_key?(f.data, :password_confirmation) || Map.has_key?(f.params, "password_confirmation")} class="form-control w-full">
        <label class="label" for="reset-password-confirmation">
          <span class="label-text font-medium">Confirm New Password</span>
        </label>
        <input 
          id="reset-password-confirmation"
          type="password" 
          name={f[:password_confirmation].name}
          value={f[:password_confirmation].value}
          required 
          placeholder="••••••••" 
          class={["input input-bordered w-full focus:outline-primary", f[:password_confirmation].errors != [] && "input-error"]} 
        />
        <div :for={{msg, _opts} <- f[:password_confirmation].errors} class="label py-1">
          <span class="label-text-alt text-error font-medium"><%= msg %></span>
        </div>
      </div>

      <div class="pt-2">
        <button type="submit" class="btn btn-primary w-full text-base font-medium shadow-sm">
          Reset Password
        </button>
      </div>

    </.form>

    <div class="mt-6 pt-4 border-t border-base-200 text-center text-xs text-base-content/70">
      Remember your password? 
      <.link navigate={~p"/auth/log_in"} class="text-primary font-semibold hover:underline ml-1">
        Sign in
      </.link>
    </div>

  </div>
</div>