<div class="space-y-6">
  <div>
    <h1 class="text-2xl font-bold">Affiliate</h1>
    <p class="text-sm text-base-content/60 mt-1">
      Share link to invite registrations, earn commissions based on plan and top-up rules
    </p>
  </div>

  <div class="card bg-base-100 shadow-sm border border-base-300">
    <div class="card-body space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <div class="text-xs text-base-content/60 mb-1">Referral Overview</div>
          <h2 class="card-title text-base font-bold">
            Share once, keep earning ongoing referral income
          </h2>
          <p class="text-xs text-base-content/60 mt-1">
            Friends register via your dedicated link and make qualifying purchases, commissions will be credited automatically.
          </p>
        </div>
        <div class="badge bg-gray-100 text-black font-mono text-xs px-3 py-2">
          Referral Code <span class="font-bold">{@user.invite_code}</span>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
        <div class="bg-base-200/40 p-6 rounded-2xl border border-base-300/40 w-full flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <span class="text-xs text-base-content/60">Withdrawable Commission</span>
            <button class="btn btn-sm btn-ghost bg-base-200/80 font-normal">Request Withdrawal</button>
          </div>
          <div class="mt-3">
            <div class="text-4xl font-bold text-warning">
              {currency_symbol()}{format_amount(
                (@user_commissions && @user_commissions.commission_balance) || 0
              )}
            </div>
            <div class="text-xs text-base-content/50 mt-1">No withdrawable amount</div>
          </div>
        </div>

        <div class="bg-base-200/40 p-4 rounded-2xl border border-base-300/40 flex flex-col justify-center h-full">
          <div class="text-xs text-base-content/60 mb-1">Total Commission</div>
          <div class="text-2xl font-bold mt-1">
            {currency_symbol()}{format_amount(
              (@user_commissions && @user_commissions.total_earned) || 0
            )}
          </div>
        </div>

        <div class="bg-base-200/40 p-4 rounded-2xl border border-base-300/40 flex flex-col justify-center h-full">
          <div class="text-xs text-base-content/60 mb-1">Successful Affiliates</div>
          <div class="text-2xl font-bold mt-1">{@affiliate_count} people</div>
        </div>
      </div>
    </div>
  </div>

  <div class="card bg-base-100 shadow-sm border border-base-300">
    <div class="card-body space-y-3">
      <h2 class="card-title text-base font-bold">Exclusive Referral Link</h2>
      <p class="text-xs text-base-content/60">
        Copy and share with friends, referral relationship is automatically bound upon registration
      </p>

      <% aff_url =
        Hakkawine.System.get_setting("site_url") <> ~p"/auth/register?affid=#{@user.invite_code}" %>
      <div class="flex items-center gap-2">
        <div class="flex-1 px-3 py-1.5 bg-base-200/60 border border-base-300/40 rounded-lg font-mono text-xs truncate select-all">
          {aff_url}
        </div>
        <button
          type="button"
          class="btn btn-warning text-warning-content btn-sm font-normal shrink-0"
          data-clipboard-url={aff_url}
          onclick="
            const url = this.getAttribute('data-clipboard-url');
            navigator.clipboard.writeText(url).then(() => {
              const btn = this;
              const originalText = btn.innerText;
              btn.innerText = 'Copied!';
              setTimeout(() => { btn.innerText = originalText; }, 2000);
            });
          "
        >
          Copy Link
        </button>
      </div>
    </div>
  </div>

  <div class="card bg-base-100 shadow-sm border border-base-300">
    <div class="card-body space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="card-title text-base font-bold">Commission Rules</h2>
          <p class="text-xs text-base-content/60 mt-0.5">
            Currently based on default commission rates for plans and top-ups
          </p>
        </div>

        <%= case length(@commission_rules) do %>
          <% 0 -> %>
            <span class="text-xs text-base-content/40 italic">No rules</span>
          <% count -> %>
            <button
              type="button"
              class="btn btn-sm btn-ghost text-xs font-normal gap-1"
              phx-click="toggle_commission_rules"
            >
              {ngettext("1 rule", "%{count} rules", count)}
              <span class={[
                "transition-transform duration-200 inline-block",
                @show_rules && "rotate-180"
              ]}>
                ▼
              </span>
            </button>
        <% end %>
      </div>

      <%= if Enum.empty?(@commission_rules) do %>
        <span class="text-sm text-base-content/40 italic">No rules configured</span>
      <% else %>
        <div
          id="rules-content"
          class={["grid grid-cols-1 md:grid-cols-2 gap-3", !@show_rules && "hidden"]}
        >
          <%= for rule <- @commission_rules do %>
            <div class="bg-base-200/40 p-4 rounded-xl border border-base-300/40 flex items-center justify-between">
              <div>
                <div class="font-semibold text-sm">{rule.product.name}</div>
                <div class="text-xs text-base-content/60 mt-0.5">
                  <%= case rule.reward_cycle do %>
                    <% :first_order -> %>
                      First-time Commission
                    <% :recurring -> %>
                      Continuous Commission
                    <% _ -> %>
                      Unknown
                  <% end %>
                </div>
              </div>
              <div class="text-right">
                <div class="font-bold text-warning text-base">
                  <%= case rule.reward_type do %>
                    <% :percentage -> %>
                      {to_percentage(rule.reward_value)}
                    <% :fixed -> %>
                      {"$#{Decimal.round(rule.reward_value, 2)}"}
                    <% _ -> %>
                      {rule.reward_value}
                  <% end %>
                </div>

                <div class="text-xs text-base-content/50">
                  <%= case rule.reward_type do %>
                    <% :percentage -> %>
                      Default Rate
                    <% :fixed -> %>
                      Default Amount
                    <% _ -> %>
                      Default
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="card bg-base-100 shadow-sm border border-base-300">
    <div class="card-body space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="card-title text-base font-bold">Commission Records</h2>
          <p class="text-xs text-base-content/60 mt-0.5">
            View source and crediting status of each referral income
          </p>
        </div>
        <span class="badge badge-neutral text-xs px-2.5 py-1">0 records</span>
      </div>

      <div class="py-8 text-center text-xs text-base-content/60">
        No commission records
      </div>
    </div>
  </div>

  <div class="card bg-base-100 shadow-sm border border-base-300">
    <div class="card-body space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="card-title text-base font-bold">Withdrawal Records</h2>
          <p class="text-xs text-base-content/60 mt-0.5">
            Track balance and USDT withdrawal processing status
          </p>
        </div>
        <span class="badge badge-neutral text-xs px-2.5 py-1">0 records</span>
      </div>

      <div class="py-8 text-center text-xs text-base-content/60">
        No withdrawal records
      </div>
    </div>
  </div>
</div>
